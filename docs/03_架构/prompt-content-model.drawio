<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-04-19T17:11:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="prompt-content-model" name="Prompt Content Model">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="10" value="Prompt Content Model&#xa;Why prompt is first-class content, and how it differs from asset, workflow, and discussion thread." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#F8FAFC;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="20" value="Core object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B45309;strokeColor=#92400E;fontColor=#FFFBEB;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="360" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="PromptEntry&#xa;prompt case / method content / distributable object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=19;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="250" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="22" value="Core fields&#xa;id / author_id / title / summary / modality / source_platform&#xa;prompt_raw / prompt_zh / model_name / tags / publish_status / visibility" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FBBF24;fontColor=#78350F;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="100" y="380" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="23" value="Why first-class content&#xa;1. User consumes the prompt itself, not only the file&#xa;2. It can be searched, commented, saved, distributed, and reused&#xa;3. It can attach many examples without depending on one single image or one single video" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FDBA74;fontColor=#9A3412;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="530" width="340" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="30" value="Example result layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#5B21B6;fontColor=#F5F3FF;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="PromptExampleLink&#xa;one PromptEntry can attach many example results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="250" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="Suggested fields&#xa;prompt_entry_id / media_asset_id / display_order&#xa;role = cover | gallery | preview&#xa;caption / generation_note" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C084FC;fontColor=#581C87;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="540" y="380" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="33" value="MediaAsset&#xa;image / preview_video / source_video / cover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C084FC;fontColor=#581C87;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="530" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="34" value="Key rule&#xa;example asset is display layer for a prompt&#xa;it is not the prompt body itself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C084FC;fontColor=#581C87;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="540" y="660" width="280" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="40" value="Relation to other content types" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15803D;strokeColor=#166534;fontColor=#F0FDF4;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="150" width="360" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="41" value="Workflow&#xa;more like runnable method container&#xa;may contain nodes, params, versions, canvas mapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="250" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="42" value="Video&#xa;more like result work&#xa;focus on playback, cover, exposure, interaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="390" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="43" value="DiscussionThread&#xa;more like discussion container&#xa;focus on body text, reply, object binding, point of view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="530" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="44" value="Suggested relation&#xa;PromptEntry can:&#xa;1. bind to Workflow as prompt scheme source&#xa;2. be referenced by Video as source prompt&#xa;3. be bound by thread for prompt-writing discussion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFCCB;strokeColor=#84CC16;fontColor=#365314;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="670" width="320" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="50" value="Distribution and interaction layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1E3A8A;fontColor=#EFF6FF;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="150" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="51" value="FeedItem&#xa;PromptEntry enters home / featured / topic flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1350" y="250" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="52" value="Comment / Favorite / Like / Copy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1350" y="390" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="53" value="Possible dedicated pages later&#xa;/explore/prompts&#xa;/prompts/[id]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1350" y="530" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="60" value="Decision rule&#xa;If user saves, discusses, searches, or distributes the prompt itself, it should be first-class content.&#xa;If it only serves as a file attached to something else, it is just an asset." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#111827;fontColor=#F9FAFB;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="890" width="820" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="100" value="body fields" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;strokeColor=#D97706;fontColor=#92400E;" edge="1" parent="1" source="21" target="22">
