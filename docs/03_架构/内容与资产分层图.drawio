        </mxCell>

        <mxCell id="20" value="第一层：文件 / 二进制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1E3A8A;fontColor=#EFF6FF;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="300" height="60" as="geometry" />
