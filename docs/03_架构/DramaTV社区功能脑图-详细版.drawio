<mxfile host="app.diagrams.net" modified="2026-04-20T23:10:00.000+08:00" agent="Codex" version="24.7.17" type="device">
  <diagram id="dramatv-community-planning-mindmap-20260420" name="DramaTV社区功能脑图-详细规划版">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="2600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="root" value="DramaTV 社区上线规划脑图&#xa;当前节点：基础功能闭环已完成&#xa;目标：从本地 PGC 原型推进到可上线社区产品" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;fontColor=#ffffff;strokeColor=#1e293b;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="80" y="1160" width="330" height="110" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="1. 项目定位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#60a5fa;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="210" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b1a" value="不是普通短视频站&#xa;不是单纯官网&#xa;是 AI 视频生成社区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;" vertex="1" parent="1">
          <mxGeometry x="860" y="40" width="260" height="92" as="geometry" />
        </mxCell>
        <mxCell id="b1b" value="核心差异&#xa;展示结果：视频 / 图片&#xa;展示方法：提示词 / 工作流&#xa;沉淀讨论：帖子 / 评论 / 经验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fbff;strokeColor=#bfdbfe;" vertex="1" parent="1">
          <mxGeometry x="1240" y="30" width="320" height="112" as="geometry" />
        </mxCell>
        <mxCell id="b1c" value="阶段判断&#xa;PGC 冷启动阶段&#xa;先做社区闭环&#xa;再增强画布联动和 UGC 机制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1660" y="35" width="300" height="102" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="2. 已完成基础闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#4ade80;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="360" width="210" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b2a" value="正式工程已切换&#xa;前端：apps/web，Next.js + React + TypeScript&#xa;后端：apps/server，Spring Boot&#xa;旧 Vite 原型已归档" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;" vertex="1" parent="1">
          <mxGeometry x="860" y="260" width="340" height="112" as="geometry" />
        </mxCell>
        <mxCell id="b2b" value="页面闭环已具备&#xa;/ 首页入口&#xa;/home 内容首页&#xa;/featured 精选资源库&#xa;/discussions 讨论广场&#xa;/publish 发布中心&#xa;/videos / workflows / prompts 详情&#xa;/creators 作者页 /me 个人中心&#xa;/canvas 画布占位入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fee7;strokeColor=#bbf7d0;" vertex="1" parent="1">
          <mxGeometry x="1290" y="230" width="360" height="168" as="geometry" />
        </mxCell>
        <mxCell id="b2c" value="后端接口已落地&#xa;登录 / 会话 / 个人中心&#xa;首页 Feed / 内容详情 / 作者聚合&#xa;提示词库 / 讨论 / 评论&#xa;点赞 / 收藏 / 关注&#xa;视频发布 / 帖子发布 / 工作流草稿&#xa;上传策略 / 本地媒体写入&#xa;画布复制与 runtime 占位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1740" y="225" width="360" height="178" as="geometry" />
        </mxCell>
        <mxCell id="b2d" value="已验证可用的用户链路&#xa;游客浏览首页&#xa;受限点击触发登录&#xa;登录后访问详情 / 发布 / 画布&#xa;发布帖子后进入讨论详情&#xa;发布视频后进入视频详情&#xa;互动数据从 0 开始真实写入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#86efac;" vertex="1" parent="1">
          <mxGeometry x="2180" y="245" width="340" height="142" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="3. 当前数据现状" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="690" width="210" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b3a" value="数据库已落地 PostgreSQL&#xa;users / creator_profiles&#xa;videos / workflows / feed_items&#xa;prompt_entries / prompt_example_links&#xa;discussion_threads / comments&#xa;interaction_actions / follow_relations&#xa;publish_drafts / audit_records / report_tickets&#xa;canvas_* / async_task_records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fcd34d;" vertex="1" parent="1">
          <mxGeometry x="860" y="590" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="b3b" value="本地数据来源&#xa;YouMind 图片提示词已导入 prompt_entries&#xa;YouMind 视频提示词已导入 prompt_entries&#xa;可播放视频资产来自本地 youmind-video-assets&#xa;工作流仍以本地种子 / 占位数据为主" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fdba74;" vertex="1" parent="1">
          <mxGeometry x="1290" y="610" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b3c" value="媒体存储现状&#xa;当前 provider = local_fs&#xa;文件落在 tmp/media&#xa;数据库只保存 object_key / metadata&#xa;上线后大文件必须迁移到 OSS / S3 / MinIO + CDN&#xa;源码仓库不长期保存大视频" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1740" y="600" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b3d" value="数据库适合保存&#xa;用户 / 作者资料&#xa;内容元数据 / 状态 / 权限&#xa;提示词正文 / 标签 / 关系&#xa;评论 / 点赞 / 收藏 / 关注&#xa;发布草稿 / 审核记录 / 任务记录&#xa;媒体文件只保存引用，不保存二进制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffef2;strokeColor=#fcd34d;" vertex="1" parent="1">
          <mxGeometry x="2180" y="600" width="340" height="152" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="4. 当前明确缺口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#f87171;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="1040" width="210" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b4a" value="审核机制未完整上线&#xa;已有 audit_records / report_tickets 表&#xa;已有 internal audit callback 接口位&#xa;但没有后台管理系统&#xa;当前视频和帖子为本地直发&#xa;后续审核归入独立后台管理系统" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#fda4af;" vertex="1" parent="1">
          <mxGeometry x="860" y="940" width="360" height="148" as="geometry" />
        </mxCell>
        <mxCell id="b4b" value="媒体处理仍是简化版&#xa;没有正式转码队列&#xa;没有封面抽帧流水线&#xa;没有 preview/source 多规格产物&#xa;没有病毒扫描 / 内容安全扫描&#xa;当前适合本地演示，不适合直接公网承压" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#fecaca;" vertex="1" parent="1">
          <mxGeometry x="1290" y="940" width="360" height="148" as="geometry" />
        </mxCell>
        <mxCell id="b4c" value="画布联动仍是产品位&#xa;copy-to-canvas 可创建 runtime 占位&#xa;可展示 light snapshot&#xa;但未接公司真实画布账号 / 空间 / 工作流复制 API&#xa;登录未来也要以画布产品登录为主" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#fda4af;" vertex="1" parent="1">
          <mxGeometry x="1740" y="950" width="360" height="132" as="geometry" />
        </mxCell>
        <mxCell id="b4d" value="推荐搜索仍待增强&#xa;当前主要是数据库查询和本地排序&#xa;缺少搜索引擎 / 索引更新&#xa;缺少运营配置后台&#xa;缺少冷启动内容池管理&#xa;缺少真实热度、完播、复制率等推荐信号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#fecaca;" vertex="1" parent="1">
          <mxGeometry x="2180" y="940" width="340" height="148" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="5. 云迁移规划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="1380" width="210" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b5a" value="必须迁移到云的内容&#xa;视频源文件 source&#xa;视频预览 preview&#xa;封面 poster / cover&#xa;图片示例资产&#xa;用户上传附件&#xa;画布 runtime 可见资产" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#c4b5fd;" vertex="1" parent="1">
          <mxGeometry x="860" y="1290" width="320" height="138" as="geometry" />
        </mxCell>
        <mxCell id="b5b" value="继续放数据库的内容&#xa;用户账号映射和会话&#xa;内容标题 / 摘要 / 标签 / 状态&#xa;提示词正文和版本&#xa;媒体 metadata 与对象存储 key&#xa;评论互动关系&#xa;审核和任务状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#ddd6fe;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1290" width="320" height="138" as="geometry" />
        </mxCell>
        <mxCell id="b5c" value="建议上线形态&#xa;前端：Next.js 部署到 Web 服务 / Vercel 类平台 / 自建 Node&#xa;后端：Spring Boot 容器化部署&#xa;数据库：云 PostgreSQL&#xa;缓存：云 Redis&#xa;媒体：OSS / S3 / MinIO + CDN&#xa;入口：Nginx / 网关 + HTTPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1660" y="1275" width="360" height="168" as="geometry" />
        </mxCell>
        <mxCell id="b5d" value="迁移顺序建议&#xa;1. 固化线上库表和种子数据&#xa;2. 上传链路切 OSS 预签名&#xa;3. 迁移 YouMind 媒体资产到 OSS&#xa;4. 将 object_key 批量回写数据库&#xa;5. 接 CDN 域名和缓存策略&#xa;6. 再接审核后台和 Worker 队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f5ff;strokeColor=#c4b5fd;" vertex="1" parent="1">
          <mxGeometry x="2100" y="1275" width="360" height="168" as="geometry" />
        </mxCell>

        <mxCell id="b6" value="6. 下一阶段优先级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#38bdf8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="1730" width="210" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b6a" value="P0 上线前必须补齐&#xa;生产登录对接画布账号体系&#xa;OSS 上传与媒体访问鉴权&#xa;基础审核后台或审核队列&#xa;发布后内容分发规则&#xa;错误码 / requestId / 日志追踪闭环&#xa;最小运维部署文档" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#7dd3fc;" vertex="1" parent="1">
          <mxGeometry x="860" y="1640" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b6b" value="P1 体验增强&#xa;搜索与筛选体验&#xa;个人中心内容管理&#xa;草稿列表 / 编辑 / 删除&#xa;通知中心&#xa;作者页内容聚合优化&#xa;运营精选 / 榜单配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#a5f3fc;" vertex="1" parent="1">
          <mxGeometry x="1290" y="1650" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b6c" value="P2 深化能力&#xa;真实复制到画布&#xa;工作流派生链&#xa;画布运行结果回流社区&#xa;AI 生成任务中心&#xa;高级推荐 / 搜索索引&#xa;多角色运营后台" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#7dd3fc;" vertex="1" parent="1">
          <mxGeometry x="1690" y="1650" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b6d" value="暂不抢主线&#xa;复杂交易体系&#xa;复杂 UGC 治理模型&#xa;重度微服务拆分&#xa;复杂推荐系统&#xa;完整画布 runtime 编辑器&#xa;这些等 PGC 闭环稳定后再推进" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="2090" y="1650" width="340" height="130" as="geometry" />
        </mxCell>

        <mxCell id="b7" value="7. 汇报结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="2100" width="210" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b7a" value="现在已经不是纯 UI demo&#xa;已具备真实前后端、数据库、登录、发布、互动、详情、讨论和画布入口闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="860" y="2040" width="380" height="98" as="geometry" />
        </mxCell>
        <mxCell id="b7b" value="距离上线的主要差距&#xa;不是页面数量&#xa;而是生产级基础设施：审核、云存储、媒体处理、账号对接、运维监控、搜索推荐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="2040" width="400" height="98" as="geometry" />
        </mxCell>
        <mxCell id="b7c" value="下一步建议&#xa;先把本地真实数据迁移为云端 PGC 内容池&#xa;再接画布登录和 OSS 上传&#xa;最后补审核后台和运营配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="1840" y="2040" width="380" height="98" as="geometry" />
        </mxCell>

