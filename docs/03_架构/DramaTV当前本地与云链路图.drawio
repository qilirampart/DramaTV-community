  <diagram id="dramatv-media-boundary" name="Media And Boundary">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="200" value="DramaTV 媒体链路与开发边界&#xa;上传、代理读取、验收分工、本地暂不能直连测试 OSS 的原因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#F8FAFC;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1640" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="210" value="当前媒体上传与读取链路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#6D28D9;fontColor=#F5F3FF;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="760" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="211" value="前端上传动作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;fontColor=#4C1D95;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="260" width="120" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="212" value="POST /api/uploads/image-policy&#xa;或 /api/uploads/video-policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="250" width="190" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="213" value="media_assets&#xa;写入 pending_upload 记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="480" y="250" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="214" value="PUT /api/uploads/assets/{id}/binary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="400" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="215" value="UploadApplicationService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDD6FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="400" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="216" value="storageProvider = local_fs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFCCB;strokeColor=#84CC16;fontColor=#365314;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="390" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="217" value="写入本地 media 目录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#A3E635;fontColor=#365314;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="560" y="500" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="218" value="storageProvider = oss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#C084FC;fontColor=#6B21A8;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="520" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="219" value="Aliyun OSS SDK&#xa;putObject 写入 OSS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C084FC;fontColor=#6B21A8;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="320" y="640" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="220" value="media_assets&#xa;更新为 ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#4C1D95;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="640" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="221" value="读取时统一走 /media/...&#xa;本地可直出，云端可代理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#A855F7;fontColor=#581C87;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="640" width="170" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="230" value="当前正式开发与验收分工" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1E40AF;fontColor=#EFF6FF;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="140" width="720" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="231" value="本地 3106 -> 18080&#xa;优先做业务开发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#60A5FA;fontColor=#1E3A8A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="260" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="232" value="页面交互&#xa;接口契约&#xa;发布表单逻辑&#xa;评论 / 点赞 / 收藏&#xa;草稿流转&#xa;聚合查询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="950" y="390" width="180" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="233" value="本地 3107 -> 8.141.20.130&#xa;优先做云资源验收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="260" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="234" value="云数据库 / 云 Redis&#xa;OSS 写入&#xa;OSS 代理读取&#xa;私有桶媒体展示&#xa;真实导入数据验收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1200" y="390" width="190" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="235" value="不建议直接在云服务器改源码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1450" y="260" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="236" value="原因&#xa;会让本地源码与云上运行态&#xa;失去单一事实来源&#xa;后续排障和回溯都更乱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#F87171;fontColor=#991B1B;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1450" y="390" width="170" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="240" value="为什么本地当前不能直接复用测试环境 OSS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9A3412;strokeColor=#7C2D12;fontColor=#FFF7ED;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="640" width="720" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="241" value="当前测试环境 OSS 条件&#xa;Bucket: dz-ailab-community&#xa;域名: oss-cn-beijing-internal&#xa;认证: RAM Role -> ECS&#xa;权限: 私有读写&#xa;当前无 CDN / 公网展示域名" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;fontColor=#9A3412;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="760" width="200" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="242" value="本地不能直连的原因&#xa;1. internal 域名是内网方案&#xa;2. RAM Role 依赖 ECS 元数据&#xa;3. 私有桶浏览器不能直出&#xa;4. 当前仍要靠 /media/... 代理展示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;fontColor=#9A3412;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="760" width="210" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="243" value="如果后续要让本地也接 OSS&#xa;还缺这些条件&#xa;- 本机可访问的公网 endpoint 或自定义域名&#xa;- 本地可用 AK/SK 或 STS&#xa;- 独立开发前缀，例如 community/dev-local/..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1440" y="760" width="180" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="244" value="当前最稳妥工作流&#xa;本地写代码 -> 本地验收业务逻辑&#xa;再用 3107 -> 云后端验收真实媒体链路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFCCB;strokeColor=#84CC16;fontColor=#365314;fontSize=15;fontStyle=1;" vertex="1" parent="1">
