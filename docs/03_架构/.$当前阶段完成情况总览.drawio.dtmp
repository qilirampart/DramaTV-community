        <mxCell id="10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#111827;fontColor=#FFFFFF;fontSize=24;fontStyle=1;" value="DramaTV 社区&#xa;当前阶段完成情况总览" vertex="1">
