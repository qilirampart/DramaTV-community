        <mxCell id="41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;fontStyle=1;align=left;spacingLeft=12;" value="当前正在运行的本地服务&#xa;- PostgreSQL : 5432 : healthy&#xa;- Redis : 6379 : healthy&#xa;- pgAdmin : 5050 : running&#xa;- pgAdmin 已修复默认邮箱配置问题" vertex="1">
