        <mxCell id="11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=18;fontStyle=1;" value="截至 2026-04-07&#xa;主线骨架、文档体系、前后端 scaffold、本地基础设施均已落地" vertex="1">
