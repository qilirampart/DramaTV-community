{
  "name": "dramatv-community-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "typecheck": "npm run typecheck:web && npm run typecheck:admin",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "typecheck:admin": "npm --prefix apps/admin run typecheck",
    "build": "npm run build:web && npm run build:admin",
    "backend-test": "npm run backend-test:core",
    "backend-test:core": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-backend-integration-suite.ps1 -Suite core",
    "backend-test:read": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-backend-integration-suite.ps1 -Suite read",
    "backend-test:admin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-backend-integration-suite.ps1 -Suite admin",
    "backend-test:logging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-backend-integration-suite.ps1 -Suite logging",
    "backend-test:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-backend-integration-suite.ps1 -Suite full",
    "api-smoke": "npm run smoke:api",
    "auth-session-smoke": "npm run smoke:auth-session",
    "notification-smoke": "npm run smoke:notifications",
    "browser-smoke": "npm run smoke:browser",
    "smoke:web": "npm --prefix apps/web run smoke",
    "smoke:admin": "npm --prefix apps/admin run smoke",
    "verify:quick": "npm run typecheck && npm run backend-test && npm run api-smoke && npm run auth-session-smoke",
    "verify:full": "npm run typecheck && npm run build && npm run backend-test && npm run api-smoke && npm run auth-session-smoke && npm run browser-smoke",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "build:web": "npm --prefix apps/web run build",
    "build:admin": "npm --prefix apps/admin run build",
    "start:web:cloud": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-web-cloud.ps1",
    "dev:prototype": "npm --prefix archive/legacy-react-vite-prototype run dev",
    "build:prototype": "npm --prefix archive/legacy-react-vite-prototype run build",
    "smoke:api": "node scripts/run-local-community-api-smoke.mjs --output artifacts/api-smoke/latest/summary.json",
    "smoke:auth-session": "node scripts/run-local-auth-session-regression.mjs --output artifacts/auth-session-smoke/latest/summary.json",
    "smoke:notifications": "node scripts/run-local-notification-regression.mjs --output artifacts/notification-smoke/latest/summary.json",
    "smoke:browser": "python scripts/run-local-community-browser-smoke.py --output artifacts/browser-smoke/latest/summary.json",
    "perf:frontend:baseline": "python scripts/run-local-frontend-performance-baseline.py --output artifacts/frontend-performance/latest/summary.json",
    "readiness:local": "node scripts/check-local-runtime-readiness.mjs --scope all --output artifacts/runtime-readiness/latest/summary.json",
    "readiness:local:backend": "node scripts/check-local-runtime-readiness.mjs --scope backend --output artifacts/runtime-readiness/latest/backend-summary.json",
    "readiness:test": "node scripts/check-test-runtime-readiness.mjs --public-base-url http://community.8.141.20.130.nip.io --output artifacts/runtime-readiness/test/summary.json",
    "deploy:verify:pre": "npm run verify:quick",
    "deploy:verify:post:test": "npm run readiness:test",
    "deploy:test:web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-test-web.ps1 -VerifyBeforeDeploy -VerifyAfterDeploy",
    "deploy:test:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-test-backend.ps1 -VerifyBeforeDeploy -VerifyAfterDeploy",
    "deploy:test:admin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-test-admin.ps1 -VerifyBeforeDeploy -VerifyAfterDeploy",
    "release:list:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/list-test-releases.ps1",
    "release:stamp:baseline:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stamp-test-stable-baseline.ps1",
    "rollback:test:web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rollback-test-web.ps1",
    "rollback:test:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rollback-test-backend.ps1",
    "rollback:test:admin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rollback-test-admin.ps1",
    "stability:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-local-stability-suite.ps1 -SkipFrontendBuild -SkipBrowserSmoke",
    "stability:local:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-local-stability-suite.ps1",
    "stability:cleanup:preview": "node scripts/cleanup-local-community-stale-data.mjs --output artifacts/stability-cleanup/latest/summary.json",
    "stability:cleanup:apply": "node scripts/cleanup-local-community-stale-data.mjs --apply --output artifacts/stability-cleanup/latest/summary.json",
    "content:cleanup:preview": "node scripts/cleanup-local-smoke-demo-content.mjs --output artifacts/content-cleanup/latest/summary.json",
    "content:cleanup:apply": "node scripts/cleanup-local-smoke-demo-content.mjs --apply --output artifacts/content-cleanup/latest/summary.json",
    "media:audit": "node scripts/audit-media-asset-keys.mjs",
    "media:normalize:preview": "node scripts/normalize-media-asset-keys.mjs",
    "media:normalize:apply": "node scripts/normalize-media-asset-keys.mjs --apply",
    "media:derivatives:backfill:preview": "node scripts/backfill-media-derivative-tasks.mjs",
    "media:derivatives:backfill:apply": "node scripts/backfill-media-derivative-tasks.mjs --apply",
    "moderation:backfill:preview": "node scripts/backfill-historical-moderation-audits.mjs",
    "moderation:backfill:apply": "node scripts/backfill-historical-moderation-audits.mjs --apply"
  }
}
